{
  "name": "mms-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "admin:create": "node dist/admin-create.js",
    "dev": "tsx watch src/server.ts",
    "test:unit": "node --import tsx --test test/sms-provider.test.mjs test/phone-normalization.test.mjs test/staff-domain.test.mjs test/facebook-auth.test.mjs test/shop-domain.test.mjs",
    "test:integration": "node --test test/auth.integration.test.mjs",
    "test:facebook-integration": "node --test test/facebook.integration.test.mjs",
    "test:staff-integration": "node --test test/staff-tickets.integration.test.mjs",
    "test:b1": "sh test/run-b1-isolated.sh",
    "shop:seed": "node dist/shop-seed.js",
    "test:shop-integration": "node --test test/shop.integration.test.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "libphonenumber-js": "^1.13.13",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
