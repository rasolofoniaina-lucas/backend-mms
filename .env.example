DATABASE_URL=postgresql://mms:change-me@db:5432/mms
OTP_PEPPER=replace-with-a-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-a-different-long-random-secret
CUSTOMER_PIN_PEPPER=replace-with-a-third-long-random-secret
SMS_PROVIDER=console
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
# Set to 1 only for controlled automated tests. Never use console SMS in production.
MMS_TEST_MODE=0
# Malagasy Yas prefixes that require manual verification (comma separated).
YAS_PHONE_PREFIXES=+26134

# Facebook Login (leave empty until the Meta application is configured).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://mms.mg/api/auth/facebook/callback
